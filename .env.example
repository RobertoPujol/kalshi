# ── Kalshi credentials ────────────────────────────────────────────────────────
# API Key ID (UUID) from https://kalshi.com/account/profile → API Keys
KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000

# Path to the PEM-encoded RSA private key that was generated when you
# created the API key.  Keep this file readable only by your user
# (chmod 600).
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/private_key.pem

# Environment: "prod" (default) or "demo"
KALSHI_ENV=prod

# ── Safety ────────────────────────────────────────────────────────────────────
# Set to true to log all orders without actually submitting them
DRY_RUN=true

# ── Risk limits (USD + contracts) ─────────────────────────────────────────────
MAX_POSITION_USD=25
MAX_TOTAL_EXPOSURE=100
MAX_POSITIONS=8
MIN_ORDER_CONTRACTS=2
MAX_SPREAD_ENTRY=0.06
MIN_LIQUIDITY=500

# ── Market making (prices in $, 0.01–0.99) ────────────────────────────────────
MM_HALF_SPREAD=0.02
MM_REPRICE_THRESHOLD=0.01
MM_MIN_PRICE=0.04
MM_MAX_PRICE=0.96

# ── Directional strategy ──────────────────────────────────────────────────────
DIR_MIN_DEVIATION=0.05
DIR_TAKE_PROFIT=0.04
DIR_STOP_LOSS=0.03

# ── Scanner ───────────────────────────────────────────────────────────────────
SCANNER_MIN_SCORE=30
SCANNER_PRICE_LOW=0.05
SCANNER_PRICE_HIGH=0.95

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=kalshitrader.db
