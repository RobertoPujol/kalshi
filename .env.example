# ── Polymarket credentials ────────────────────────────────────────────────────
# Your Ethereum private key (hex). KEEP THIS SECRET.
PK=0xYOUR_PRIVATE_KEY_HERE

# Your MetaMask / browser wallet address (holds USDC on Polygon)
BROWSER_ADDRESS=0xYOUR_WALLET_ADDRESS

# Optional: override CLOB host
# POLY_HOST=https://clob.polymarket.com

# ── Polygon RPC (for on-chain data) ───────────────────────────────────────────
# Public default works but is slow. Free QuickNode/Alchemy tier recommended.
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# ── Safety ────────────────────────────────────────────────────────────────────
# Set to true to log all orders without actually submitting them
DRY_RUN=true

# ── Risk limits ───────────────────────────────────────────────────────────────
MAX_POSITION_USDC=25
MAX_TOTAL_EXPOSURE=100
MAX_POSITIONS=8
MIN_ORDER_USDC=2
MAX_SPREAD_ENTRY=0.06
MIN_LIQUIDITY=500

# ── Market making ─────────────────────────────────────────────────────────────
MM_HALF_SPREAD=0.02
MM_REPRICE_THRESHOLD=0.005
MM_MIN_PRICE=0.04
MM_MAX_PRICE=0.96

# ── Directional strategy ──────────────────────────────────────────────────────
DIR_MIN_DEVIATION=0.05
DIR_TAKE_PROFIT=0.04
DIR_STOP_LOSS=0.03

# ── Scanner ───────────────────────────────────────────────────────────────────
SCANNER_MIN_SCORE=30
SCANNER_PRICE_LOW=0.05
SCANNER_PRICE_HIGH=0.95

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=polytrader.db
