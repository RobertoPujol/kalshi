# ── Kalshi credentials ────────────────────────────────────────────────────────
# API Key ID (UUID) from https://kalshi.com/account/profile → API Keys
KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000

# Path to the PEM-encoded RSA private key that was generated when you
# created the API key.  Keep this file readable only by your user
# (chmod 600).
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/private_key.pem

# Environment: "prod" (default) or "demo"
KALSHI_ENV=prod

# ── Safety ────────────────────────────────────────────────────────────────────
# Set to true to log all orders without actually submitting them
DRY_RUN=true

# ── Risk limits (USD + contracts) ─────────────────────────────────────────────
# Defaults tuned for current Kalshi market depth (much thinner than Polymarket
# was). Tighten back up once you've seen a few days of real activity.
MAX_POSITION_USD=25
MAX_TOTAL_EXPOSURE=100
MAX_POSITIONS=8
MIN_ORDER_CONTRACTS=2
MAX_SPREAD_ENTRY=0.10
MIN_LIQUIDITY=50

# ── Market making (prices in $, 0.01–0.99) ────────────────────────────────────
MM_HALF_SPREAD=0.02
MM_REPRICE_THRESHOLD=0.01
MM_MIN_PRICE=0.04
MM_MAX_PRICE=0.96

# ── Directional strategy ──────────────────────────────────────────────────────
DIR_MIN_DEVIATION=0.05
DIR_TAKE_PROFIT=0.04
DIR_STOP_LOSS=0.03

# ── Scanner ───────────────────────────────────────────────────────────────────
SCANNER_MIN_SCORE=30
SCANNER_PRICE_LOW=0.05
SCANNER_PRICE_HIGH=0.95

# ── Sentiment / news ──────────────────────────────────────────────────────────
# Optional: NewsAPI.org key for higher-quality headlines.
# Sign up free at https://newsapi.org — 100 req/day on the free tier.
# Without this, the engine falls back to GDELT (free, no signup required).
NEWS_API_KEY=

# How much to shift the ML fair-value estimate per unit of sentiment (-1→+1).
# Default 0.08 means a fully positive/negative article set shifts fair value
# by ±8¢.  Set to 0 to disable the sentiment overlay entirely.
SENTIMENT_WEIGHT=0.08

# Seconds to cache a topic's sentiment score (default 15 min)
SENTIMENT_CACHE_TTL=900

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=kalshitrader.db
